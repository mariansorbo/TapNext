# Copiá este archivo a .env y completá lo que necesites.
# Sin estas variables (salvo DATABASE_URL, que es obligatoria), las features
# quedan inactivas (no rompen nada).

# OBLIGATORIA — Postgres real. Connection string completo (postgres://user:pass@host:puerto/db).
# En local: tu propio Postgres (docker, instalado, o una instancia hosteada de desarrollo).
# En producción: la que te da tu proveedor (ej. Render Postgres, que se integra directo
# con el backend si están en la misma cuenta de Render).
DATABASE_URL=

# URL pública del frontend (Vercel en producción) — usada en redirects (Google OAuth, Mercado Pago).
FRONTEND_URL=http://localhost:5173

# URL pública de este backend (Render en producción) — es la que se graba en los chips NFC
# y la que recibe el webhook de Mercado Pago. En local, ngrok u otro túnel si necesitás
# probar el webhook de verdad (MP no puede llamar a localhost).
# PUBLIC_ROUTER_BASE=

# Admin panel (contraseña compartida, sin esto el panel queda inaccesible).
# ADMIN_PASSWORD=

# Programación de chips NFC reales (RS-01/RS-02).
# CHIP_MASTER_SECRET=

# Google Sign-In (opcional, alternativo al login por WhatsApp).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Mercado Pago — Checkout Pro. Usá el Access Token de PRUEBA de tu cuenta de test
# mientras desarrollás (panel de Mercado Pago > Tus integraciones > Credenciales de prueba).
# MP_ACCESS_TOKEN=

# --- Verificación de identidad del comprador (OTP passwordless) ---
# El código se manda por un canal intercambiable. Elegí cuál con VERIFICACION_CANAL:
#   email     (default) — envío por Resend, ver abajo
#   whatsapp            — WhatsApp Business API, ver más abajo
# Si el canal elegido no tiene sus credenciales cargadas, el login queda en modo
# demo (el código se muestra en la respuesta, no se envía) sin romper nada.
# VERIFICACION_CANAL=email

# Canal email — Resend (https://resend.com > API Keys). EMAIL_FROM tiene que ser
# de un dominio verificado en Resend (o usar onboarding@resend.dev para probar).
# RESEND_API_KEY=
# EMAIL_FROM=NextTap <no-reply@tudominio.com>
# EMAIL_OTP_ASUNTO=Tu código de verificación

# Canal whatsapp — WhatsApp Business Platform (Cloud API de Meta).
# Se sacan de developers.facebook.com > tu App > WhatsApp > API Setup (token temporal
# para probar) o Business Settings > System Users (token permanente de producción).
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Nombre del Message Template de categoría "Authentication" ya aprobado por Meta.
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANG=es
