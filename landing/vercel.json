{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/activacion/:codigo", "destination": "/activacion.html" },
    { "source": "/v/:codigo", "destination": "https://tapnext.onrender.com/v/:codigo" },
    { "source": "/t/visita", "destination": "https://tapnext.onrender.com/api/visitas" },
    { "source": "/t/evento", "destination": "https://tapnext.onrender.com/api/eventos" }
  ]
}
