{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/activacion/:codigo", "destination": "/activacion.html" },
    { "source": "/terminos", "destination": "/terminos.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/empresas", "destination": "/empresas.html" },
    { "source": "/v/:codigo", "destination": "https://tapnext.onrender.com/v/:codigo" },
    { "source": "/t/visita", "destination": "https://tapnext.onrender.com/api/visitas" },
    { "source": "/t/evento", "destination": "https://tapnext.onrender.com/api/eventos" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
